# Server Environment Configuration

# Server Port
PORT=5001

# Google Gemini API Key
# Obtain from https://aistudio.google.com/
# If left empty, the server automatically runs in High-Fidelity Demo/Simulation Mode
# with realistic fixtures and verified source cross-referencing.
GEMINI_API_KEY=

# Gemini Model identifier (Defaults to gemini-2.5-flash)
# Supported: gemini-2.5-flash, gemini-2.0-flash, gemini-1.5-flash
GEMINI_MODEL=gemini-2.5-flash

# Environment
NODE_ENV=development

# Allowed Origins (CORS)
ALLOWED_ORIGINS=http://localhost:5173,http://localhost:3000
